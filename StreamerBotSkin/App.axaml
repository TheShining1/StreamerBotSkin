<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:u-semi="https://irihi.tech/ursa/themes/semi"			 
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:conv="clr-namespace:StreamerBotSkin.Converters"
             xmlns:grammars="clr-namespace:TextMateSharp.Grammars;assembly=TextMateSharp.Grammars"
             xmlns:local="clr-namespace:StreamerBotSkin"
             RequestedThemeVariant="Dark"
             x:Class="StreamerBotSkin.App">
	<!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

	<Application.DataTemplates>
		<local:ViewLocator/>
	</Application.DataTemplates>


	<Application.Styles>
		<semi:SemiTheme/>
		<u-semi:SemiTheme/>
		
		<Style Selector="i|Icon">
			<Setter Property="FontSize" Value="24"/>
		</Style>
	</Application.Styles>

	<Application.Resources>
		<conv:PlatformToIconConverter x:Key="PlatformToIconConverter" />
		<conv:RoleToIconConverter x:Key="RoleToIconConverter" />
		<conv:ActionTypeToNameConverter x:Key="ActionTypeToNameConverter" />
	</Application.Resources>
</Application>