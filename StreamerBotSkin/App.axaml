<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:StreamerBotSkin.Converters"
             xmlns:local="clr-namespace:StreamerBotSkin"
			 RequestedThemeVariant="Dark"
             x:Class="StreamerBotSkin.App">
	<!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

	<Application.DataTemplates>
		<local:ViewLocator/>
	</Application.DataTemplates>

	<Application.Styles>
		<FluentTheme/>
	</Application.Styles>

	<Application.Resources>
		<conv:PlatformToIconConverter x:Key="PlatformToIconConverter" />
		<conv:RoleToIconConverter x:Key="RoleToIconConverter" />
		<conv:ActionTypeToNameConverter x:Key="ActionTypeToNameConverter" />		
	</Application.Resources>
</Application>