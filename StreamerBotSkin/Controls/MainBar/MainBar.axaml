<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:wpf="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
			 xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:sbControls="clr-namespace:StreamerBotSkin.Controls"
             x:Class="StreamerBotSkin.Controls.MainBar"
             x:Name="root">
	<Grid ColumnDefinitions="Auto, *, Auto">
		<ToggleButton Grid.Column="0"
					  i:Attached.Icon="mdi-menu"
					  IsChecked="{Binding #root.IsDrawerOpen}" />
		<StackPanel Grid.Column="1"
					Orientation="Horizontal"
					VerticalAlignment="Center">
			<Button Classes="Flat">
				<i:Icon Value="mdi-content-save"/>
			</Button>
			<Button>
				<i:Icon Value="mdi-chat"/>
			</Button>
			<Button>
				<i:Icon Value="mdi-timeline"/>
			</Button>
			<Button>
				<i:Icon Value="mdi-application-variable"/>
			</Button>
		</StackPanel>
		<StackPanel Grid.Column="3"
					Orientation="Horizontal">
			<!--<ToggleButton>
				<i:Icon Value="mdi-theme-light-dark"/>
			</ToggleButton-->
			<sbControls:MainBarMenu/>
		</StackPanel>
	</Grid>
	<!--<mControls:ColorZone Grid.Row="0">
		<Grid ColumnDefinitions="Auto, Auto, *, Auto"
          Height="24">
      <ToggleButton Grid.Column="0"
                    x:Name="NavDrawerSwitch"
                    IsChecked="{Binding IsDrawerOpen, ElementName=root}">
        <mIcons:MaterialIcon Kind="Menu"/>
      </ToggleButton>
			<StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  VerticalAlignment="Center">
				<Button Classes="Flat">
					<mIcons:MaterialIcon Kind="ContentSave"/>
				</Button>
        <Button Classes="Flat">
          <mIcons:MaterialIcon Kind="Chat"/>
        </Button>
        <Button Classes="Flat">
          <mIcons:MaterialIcon Kind="Timeline"/>
        </Button>
        <Button Classes="Flat">
					<mIcons:MaterialIcon Kind="ApplicationVariable"/>
				</Button>
			</StackPanel>
			<StackPanel Grid.Column="2"
						Orientation="Horizontal">
			</StackPanel>
			<StackPanel Grid.Column="3"
                  Orientation="Horizontal">
				<ToggleButton x:Name="ThemeToggle"
                      Click="ThemeChange">
					<mIcons:MaterialIcon Kind="ThemeLightDark"/>
				</ToggleButton>
        <sbControls:MainBarMenu/>
			</StackPanel>
		</Grid>
	</mControls:ColorZone>-->
</UserControl>
