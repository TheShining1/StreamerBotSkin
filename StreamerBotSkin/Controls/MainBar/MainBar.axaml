<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:sbControls="clr-namespace:StreamerBotSkin.Controls"
             x:Class="StreamerBotSkin.Controls.MainBar"
             x:Name="root">
	<Grid ColumnDefinitions="Auto, Auto, *, Auto">
		<StackPanel Grid.Column="1"
			  Orientation="Horizontal"
			  VerticalAlignment="Center">
			<Button Classes="Flat">
				<i:Icon Value="mdi-content-save"/>
			</Button>
			<Button Classes="Flat">
				<i:Icon Value="mdi-chat"/>
			</Button>
			<Button Classes="Flat">
				<i:Icon Value="mdi-timeline"/>
			</Button>
			<Button Classes="Flat">
				<i:Icon Value="mdi-application-variable"/>
			</Button>
		</StackPanel>
		<StackPanel Grid.Column="2"
					Orientation="Horizontal">
		</StackPanel>
		<StackPanel Grid.Column="3"
			  Orientation="Horizontal">
			<u:ThemeToggleButton></u:ThemeToggleButton>
			<sbControls:MainBarMenu/>
		</StackPanel>
	</Grid>
</UserControl>
