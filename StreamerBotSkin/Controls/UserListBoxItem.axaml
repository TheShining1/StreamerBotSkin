<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:sbModel="clr-namespace:StreamerBotSkin.Models;assembly=StreamerBotSkin"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="StreamerBotSkin.Controls.UserListBoxItem"
             x:DataType="sbModel:SBUser"
             x:Name="root">
  <StackPanel Orientation="Horizontal">
    <i:Icon Value="{Binding User.Type, ElementName=root, Converter={StaticResource PlatformToIconConverter}}"
            Margin="0,0,5,0"
            VerticalAlignment="Center"/>
    <i:Icon Value="{Binding User.Role, ElementName=root, Converter={StaticResource RoleToIconConverter}}"
            Margin="0,0,5,0"
            VerticalAlignment="Center"/>
    <TextBlock Text="{Binding User.Username, ElementName=root}"
               VerticalAlignment="Center"/>
  </StackPanel>
</UserControl>
