<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sbControls="clr-namespace:StreamerBotSkin.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="StreamerBotSkin.Controls.LogLevel">
  <sbControls:LabelledGenericControl Label="Log level">
    <sbControls:LabelledGenericControl.GenericControl>
      <ComboBox HorizontalAlignment="Center"
                Width="125"
                SelectedIndex="0">
        <TextBlock>Verbose</TextBlock>
        <TextBlock>Debug</TextBlock>
        <TextBlock>Information</TextBlock>
      </ComboBox>
    </sbControls:LabelledGenericControl.GenericControl>
  </sbControls:LabelledGenericControl>
</UserControl>
