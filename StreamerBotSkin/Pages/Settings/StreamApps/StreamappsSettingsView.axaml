<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:sbControls="clr-namespace:StreamerBotSkin.Controls.Auth"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             x:Class="StreamerBotSkin.Views.StreamappsSettingsView"
             xmlns:vm="using:StreamerBotSkin.ViewModels"
             x:DataType="vm:StreamappsSettingsViewModel">
  <Design.DataContext>
    <vm:StreamappsSettingsViewModel/>
  </Design.DataContext>
  
  <TabControl>
    <TabControl.Items>
      <TabItem Header="OBS">
        <DataGrid ItemsSource="{Binding OBSSettings}"
                  AutoGenerateColumns="True"></DataGrid>
      </TabItem>
      <TabItem Header="Streamlabs Desktop">
        <DataGrid ItemsSource="{Binding SLDSettings}"
                  AutoGenerateColumns="True"></DataGrid>
      </TabItem>
      <TabItem Header="PolyPop">
        <sbControls:AuthServer Forget="False"/>
      </TabItem>
    </TabControl.Items>
  </TabControl>
  <!--<mControls:SideSheet Width="500"
                       Height="560"
                       BorderBrush="Black"
                       BorderThickness="1"
                       SideSheetDirection="Right">
    <mControls:SideSheet.SideSheetContentTemplate>
      <DataTemplate>
        <StackPanel>
          <TextBlock>SideSHeet</TextBlock>
        </StackPanel>
      </DataTemplate>
    </mControls:SideSheet.SideSheetContentTemplate>
    <Panel>
      <Button Classes="Icon"
              Width="36"
              Height="36"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Content="{i:IconExt MenuOpen, Size=20}"/>
    </Panel>
  </mControls:SideSheet>-->
</UserControl>
