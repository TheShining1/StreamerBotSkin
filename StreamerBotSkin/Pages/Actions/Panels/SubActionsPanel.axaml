<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="StreamerBotSkin.Panels.SubActionsPanel"
			 xmlns:sbModels="clr-namespace:StreamerBotSkin.Models"
             xmlns:vm="using:StreamerBotSkin.ViewModels"
             x:DataType="vm:ActionsViewModel">
  <Grid RowDefinitions="Auto,*">
    <TextBlock Grid.Row="0">Sub-Actions</TextBlock>
    <TreeView Grid.Row="1"
              ItemsSource="{Binding CurrentSubActionsTree}">
      <TreeView.ItemTemplate>
        <TreeDataTemplate ItemsSource="{Binding Items}">
          <TextBlock Text="{Binding Name, Converter={StaticResource ActionTypeToNameConverter}}"/>
        </TreeDataTemplate>
       </TreeView.ItemTemplate>
      <!--<TreeView.ItemTemplate>
        <TreeDataTemplate>
          <Grid ColumnDefinitions="*, Auto">
            --><!--<TextBlock Grid.Column="0"
                       Text="{Binding ID}"
                       VerticalAlignment="Center"/>--><!--
            --><!--<CheckBox Grid.Column="1"
                      IsChecked="{Binding Enabled}"/>--><!--
          </Grid>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>-->
    </TreeView>
  </Grid>
</UserControl>
