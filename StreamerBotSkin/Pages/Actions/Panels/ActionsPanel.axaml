<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			       xmlns:sbModels="clr-namespace:StreamerBotSkin.Models"
			       xmlns:sbControls="clr-namespace:StreamerBotSkin.Controls"
			       xmlns:sbbControls="clr-namespace:StreamerBotControls;assembly=StreamerBotControls"
             xmlns:mIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
			       xmlns:vm="using:StreamerBotSkin.ViewModels"
			       x:DataType="vm:ActionsViewModel"
             x:Class="StreamerBotSkin.Panels.ActionsPanel">
  <UserControl.Styles>
    <Style Selector="ToggleButton:unchecked">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate>
            <mIcons:MaterialIcon Kind="ChevronDown"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style Selector="ToggleButton:checked">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate>
            <mIcons:MaterialIcon Kind="ChevronUp"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style Selector="ToggleButton:unchecked:pointerover">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate>
            <mIcons:MaterialIcon Kind="ChevronDownCircle"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style Selector="ToggleButton:checked:pointerover">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate>
            <mIcons:MaterialIcon Kind="ChevronUpCircle"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!--<Style Selector="DataGridRow">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type DataGridRow}">
          <sbControls:ActionRow/>
            -->
    <!--<TextBlock>ROW</TextBlock>-->
    <!--
          </ControlTemplate>
        </Setter.Value>
      </Setter>      
    </Style>-->
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*">
    <Grid Grid.Row="0"
          ColumnDefinitions="*,*,2*"
          VerticalAlignment="Center"
          Margin="5">
      <TextBlock Grid.Column="0"
                 Classes="Subtitle2"
                 VerticalAlignment="Center">Actions</TextBlock>
      <!--<TextBox Grid.Column="2"
               Text="{Binding NameFilter}"
               Watermark="Filter"></TextBox>-->
      <sbbControls:FilterTextField Grid.Column="2"
                                   Text="{Binding NameFilter}"/>
      <!--<StackPanel Grid.Column="3">        
        <ComboBox ItemsSource="{Binding QueuesItems}"
                  SelectedValue="{Binding SelectedQueue}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{Binding SelectedQueueId}"/>
      </StackPanel>-->
    </Grid>
    <!--<ScrollViewer Grid.Row="1">-->
    <!--<DataGrid Grid.Row="1"
              AutoGenerateColumns="False"
              ItemsSource="{Binding Path=actionsItems}"
              SelectedItem="{Binding Path=currentAction}">
      <DataGrid.DataTemplates>
        <DataGridRow></DataGridRow>
          -->
    <!--<sbControls:UserControl1></sbControls:UserControl1>-->
    <!--
      </DataGrid.DataTemplates>
    </DataGrid>-->
    <DataGrid Grid.Row="1"
              x:Name="ActionsGrid"
              AutoGenerateColumns="False"
              ColumnWidth="*"
              ItemsSource="{Binding ActionsItemsFiltered}"
              SelectedItem="{Binding currentAction}"
              CanUserResizeColumns="True"
              ColumnHeaderHeight="36"
              MinColumnWidth="50"
              VerticalScrollBarVisibility="Visible">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header=""
                                x:DataType="sbModels:SBAction"
                                CanUserResize="False"
                                Binding="{Binding Enabled}"
                                Width="24"/>
        <DataGridTextColumn Header="Name"
                            x:DataType="sbModels:SBAction"
                            Binding="{Binding Name}"/>
        <DataGridTextColumn Header="Options"
                            x:DataType="sbModels:SBAction"
                            Binding="{Binding Options}"/>
        <DataGridTextColumn Header="Triggers"
                            x:DataType="sbModels:SBAction"
                            Binding="{Binding TriggersCount}"/>
        <DataGridTemplateColumn Header="Queue">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="sbModels:SBAction">
              <!--<ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.QueuesItems}"
                        SelectedItem="{Binding Queue}"></ComboBox>-->
              <TextBlock Text="{Binding Queue}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <!--</ScrollViewer>-->
  </Grid>
</UserControl>
