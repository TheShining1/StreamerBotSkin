        <!--<Style Selector="ContextMenu">
          <Setter Property="Padding" Value="0"/>
        </Style>-->
        <!--<Style Selector="MenuItem">
          <Setter Property="Height" Value="24"/>
        </Style>-->
      <!--</DataGrid.Styles>-->
      <DataGrid.Columns>
        <!--<DataGridCheckBoxColumn Header=""
                                x:DataType="sbModels:SBAction"
                                CanUserResize="False"
                                Binding="{Binding Enabled}"
                                Width="16"/>-->
        <DataGridTemplateColumn Header=""
                                CanUserResize="False"
                                Width="18">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="sbModels:SBAction">
              <CheckBox IsChecked="{Binding Enabled}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <!--<DataGridTextColumn Header="Name"
                            x:DataType="sbModels:SBAction"
                            Binding="{Binding Name}"/>-->
        <DataGridTemplateColumn Header="Name"
								x:DataType="sbModels:SBAction">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="sbModels:SBAction">
              <TextBlock Text="{Binding Name}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Options"
                            x:DataType="sbModels:SBAction"
                            Binding="{Binding Options}"/>
        <!--<DataGridTemplateColumn Header="Options"
                            x:DataType="sbModels:SBAction">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="sbModels:SBAction">
              <TextBlock Classes="dense"
                         Text="{Binding Options}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>-->
        <DataGridTextColumn Header="Triggers"
                            x:DataType="sbModels:SBAction"
                            Binding="{Binding TriggersCount}"/>
        <!--<DataGridTemplateColumn Header="Triggers"
                            x:DataType="sbModels:SBAction">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="sbModels:SBAction">
              <TextBlock Classes="dense"
                         Text="{Binding TriggersCount}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>-->
        <DataGridTemplateColumn Header="Queue">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="sbModels:SBAction">
              <!--<ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.QueuesItems}"
                        SelectedItem="{Binding Queue}"></ComboBox>-->
              <TextBlock Text="{Binding Queue}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <!--</ScrollViewer>-->
  </Grid>
</UserControl>
