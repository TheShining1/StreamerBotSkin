<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
			       xmlns:sbModels="clr-namespace:StreamerBotSkin.Models"
			       xmlns:sbControls="clr-namespace:StreamerBotSkin.Controls"
			       xmlns:sbContextMenus="clr-namespace:StreamerBotSkin.ContextMenus"
			       xmlns:sbbControls="clr-namespace:StreamerBotControls;assembly=StreamerBotControls"
			       xmlns:vm="using:StreamerBotSkin.ViewModels"
			       x:DataType="vm:ActionsViewModel"
             x:Class="StreamerBotSkin.Panels.ActionsPanel">
  <UserControl.Styles>
    <!--<Style Selector="DataGridRow">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type DataGridRow}">
          <sbControls:ActionRow/>
            
    <TextBlock>ROW</TextBlock>
    
          </ControlTemplate>
        </Setter.Value>
      </Setter>      
    </Style>-->
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*">
    <Grid Grid.Row="0"
          ColumnDefinitions="*,*,2*"
          VerticalAlignment="Center"
          Margin="5">
      <TextBlock Grid.Column="0"
                 Classes="Subtitle2"
                 VerticalAlignment="Center">Actions</TextBlock>
      <!--<TextBox Grid.Column="2"
               Text="{Binding NameFilter}"
               Watermark="Filter"></TextBox>-->
      <sbbControls:FilterTextField Grid.Column="2"
                                   Text="{Binding NameFilter}"/>
      <!--<StackPanel Grid.Column="3">        
        <ComboBox ItemsSource="{Binding QueuesItems}"
                  SelectedValue="{Binding SelectedQueue}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{Binding SelectedQueueId}"/>
      </StackPanel>-->
    </Grid>
    <!--<ScrollViewer Grid.Row="1">-->
    <!--<DataGrid Grid.Row="1"
              AutoGenerateColumns="False"
              ItemsSource="{Binding Path=actionsItems}"
              SelectedItem="{Binding Path=currentAction}">
      <DataGrid.DataTemplates>
        <DataGridRow></DataGridRow>
          -->
    <!--<sbControls:UserControl1></sbControls:UserControl1>-->
    <!--
      </DataGrid.DataTemplates>
    </DataGrid>-->
    <DataGrid Grid.Row="1"
              AutoGenerateColumns="False"
              ColumnWidth="*"
              ItemsSource="{Binding ActionsItemsFiltered}"
              SelectedItem="{Binding CurrentAction}"
              CanUserResizeColumns="True"
              MinColumnWidth="50">
      <!--<DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Add" Command="{Binding OpenAddEditActionDialogCommand}"/>
          <Separator />
          <MenuItem Header="Collapse All" />
          <MenuItem Header="Expand All" />
        </ContextMenu>
      </DataGrid.ContextMenu>-->
      <!--<DataGrid.Styles>-->               
        <!--<Style Selector="DataGridRowGroupHeader">
          <Setter Property="IsItemCountVisible" Value="True" />
          <Setter Property="ItemCountFormat" Value="({0} actions)" />
