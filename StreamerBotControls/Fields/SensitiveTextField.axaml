<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:mAssist="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             x:Name="root"
             x:Class="StreamerBotControls.SensitiveTextField">
  <TextBox Classes="dense revealPasswordButton"
           PasswordChar="*"
           mAssist:TextFieldAssist.Label="{Binding #root.Title}"
           Text="{Binding #root.Text, Mode=TwoWay}"/>
</UserControl>
