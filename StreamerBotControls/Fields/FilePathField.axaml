<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:mAssist="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             xmlns:mIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Name="root"
             x:Class="StreamerBotControls.FilePathField">
  <TextBox Classes="dense"
           mAssist:TextFieldAssist.Label="{Binding #root.Title}"
           Text="{Binding #root.FilePath}">
    <TextBox.InnerRightContent>
      <Button Classes="flat"
              Click="OpenFileButton_Clicked">
        <mIcons:MaterialIcon HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Width="20"
                             Height="20"
                             Kind="DotsHorizontal"
                             Margin="5,0,0,0"/>
      </Button>
    </TextBox.InnerRightContent>
  </TextBox>
</UserControl>
