<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:mIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Name="root"
             x:Class="StreamerBotControls.FilterTextField">
  <TextBox Watermark="Filter"
           Classes="solo clearButton"
           BorderBrush="{Binding $self.Foreground}"
           BorderThickness="1"
           Text="{Binding #root.Text}">
    <TextBox.InnerLeftContent>
      <mIcons:MaterialIcon HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Width="20"
                           Height="20"
                           Kind="Search"
                           Margin="5,0,0,0"/>
    </TextBox.InnerLeftContent>
  </TextBox>
</UserControl>
