    <EmbeddedResource Remove="Menues\**" />
    <None Remove="Menues\**" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaXaml Remove="UserControl1.axaml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="UserControl1.axaml.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.2" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.2.2" />
    <PackageReference Include="Irihi.Avalonia.Shared" Version="0.2.1" />
    <PackageReference Include="Irihi.Avalonia.Shared.Contracts" Version="0.2.1" />
    <PackageReference Include="Irihi.Ursa" Version="1.6.1" />
    <PackageReference Include="Irihi.Ursa.Themes.Semi" Version="1.6.1" />
    <PackageReference Include="Material.Avalonia" Version="3.8.0" />
    <PackageReference Include="Material.Icons.Avalonia" Version="2.1.10" />
    <PackageReference Include="Projektanker.Icons.Avalonia" Version="9.5.0" />
    <PackageReference Include="Projektanker.Icons.Avalonia.MaterialDesign" Version="9.5.0" />
    <PackageReference Include="Semi.Avalonia" Version="11.2.1.1" />
  </ItemGroup>

  <ItemGroup>
